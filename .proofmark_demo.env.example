# Local ProofLoop demo provider configuration.
# Copy to `.proofmark_demo.env` for local demos. `.proofmark_demo.env` is gitignored.
# Intentionally use only restricted/low-balance keys for product demonstration and ease of local access.
# Do not move these values into `web/static` or committed source files.

OPENAI_API_KEY=<restricted-openai-demo-key>
OPENAI_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=high
PROOFLOOP_GENERATION_MAX_OUTPUT_TOKENS=5500

GEMINI_API_KEY=<restricted-gemini-demo-key>
GEMINI_MODEL=gemini-3.5-flash
PROOFMARK_GEMINI_TIMEOUT=90
PROOFMARK_GEMINI_MAX_OUTPUT_TOKENS=4096
PROOFMARK_GEMINI_THINKING_BUDGET=0
PROOFMARK_GEMINI_THINKING_LEVEL=minimal

PINECONE_API_KEY=<restricted-pinecone-demo-key>
PINECONE_INDEX_HOST=https://your-index-host.svc.region.pinecone.io
PINECONE_NAMESPACE=proofloop-demo

ELEVENLABS_API_KEY=<restricted-elevenlabs-demo-key>
# Optional. If omitted, the backend chooses the first available account voice.
ELEVENLABS_VOICE_ID=
# Optional. If omitted, the backend chooses a supported TTS model from the account.
ELEVENLABS_MODEL=

PROOFLOOP_GENERATE_WITH_MODEL=1
PROOFLOOP_ANALYZE_SOURCES_WITH_GEMINI=1
PROOFLOOP_USE_VECTOR_RAG=1
PROOFLOOP_FETCH_URLS=1
